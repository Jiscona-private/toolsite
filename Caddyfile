{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# WG-Manager v1 — access is its own secret join-link (/wg/join/<token>),
	# not Basic Auth; it 404s on any other request, logged in or not. Note:
	# `handle` (not `handle_path`) keeps the /wg prefix on the request
	# forwarded upstream — the module itself is prefix-aware (BASE_PATH=/wg),
	# so its own absolute links resolve correctly. A future module holding
	# personal data without its own access control would add Basic Auth
	# here instead, the same way this block used to.
	handle /wg* {
		reverse_proxy wg:3000
	}

	# HöMa I lessons — public, static, no personal data. Answers and progress
	# live only in each visitor's browser (localStorage); nothing is collected.
	handle /hoema* {
		reverse_proxy hoema:3000
	}

	# public landing page — lists every installed module.
	handle {
		reverse_proxy landing:3000
	}

	log {
		output stdout
		format console
	}
}
