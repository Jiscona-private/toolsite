# Copy this file to .env and fill in real values before deploying.
# `.env` is gitignored on purpose — never commit real secrets.

# The domain (or subdomain) pointed at this VPS's IPv4 address.
# Caddy uses this to automatically request a Let's Encrypt certificate.
# For local testing you can set this to "localhost" — Caddy will issue a
# locally-trusted dev certificate instead of talking to Let's Encrypt.
DOMAIN=example.duckdns.org

# Email used for the Let's Encrypt account (expiry/problem notices only).
ACME_EMAIL=you@example.com

# HTTP Basic Auth credentials protecting modules that hold personal data
# (e.g. wg-manager). Generate an ALREADY-ESCAPED hash with this one-liner
# (the `sed` doubles every `$`, which .env files require — see note below):
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-password' | sed 's/\$/\$\$/g'
# Paste that output directly below. If you generate the hash some other
# way, you MUST double every literal `$` yourself before pasting it here —
# Compose's .env parser treats an unescaped `$word` as a reference to
# another variable and silently blanks it out, corrupting the hash.
WG_BASIC_AUTH_USER=admin
WG_BASIC_AUTH_HASH=$$2a$$14$$REPLACE_WITH_GENERATED_HASH
