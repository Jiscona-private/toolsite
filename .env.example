# Copy this file to .env and fill in real values before deploying.
# `.env` is gitignored on purpose — never commit real secrets.

# The domain (or subdomain) pointed at this VPS's IPv4 address.
# Caddy uses this to automatically request a Let's Encrypt certificate.
# For local testing you can set this to "localhost" — Caddy will issue a
# locally-trusted dev certificate instead of talking to Let's Encrypt.
DOMAIN=example.duckdns.org

# Email used for the Let's Encrypt account (expiry/problem notices only).
ACME_EMAIL=you@example.com

# Secret key signing WG-Manager v1's cookies and CSRF tokens (modules/wg).
# Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
WG_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
