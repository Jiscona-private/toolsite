{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# keep every page out of search engines (this site is not meant to be
	# publicly discoverable, e.g. when searching the operator's name).
	# Header applies even to reverse-proxied responses, so no module needs
	# to set this itself.
	header X-Robots-Tag "noindex, nofollow, noarchive, noimageindex"

	# WG-Manager v1 — access is its own secret join-link (/wg/join/<token>),
	# not Basic Auth; it 404s on any other request, logged in or not. Note:
	# `handle` (not `handle_path`) keeps the /wg prefix on the request
	# forwarded upstream — the module itself is prefix-aware (BASE_PATH=/wg),
	# so its own absolute links resolve correctly. A future module holding
	# personal data without its own access control would add Basic Auth
	# here instead, the same way this block used to.
	handle /wg* {
		reverse_proxy wg:3000
	}

	# HöMa I lessons — public, static, no personal data. Answers and progress
	# live only in each visitor's browser (localStorage); nothing is collected.
	handle /hoema* {
		reverse_proxy hoema:3000
	}

	# EA Heidelberg concept draft — content copied from eaheidelberg.de for an
	# internal redesign review. Basic Auth keeps it off search engines and
	# away from casual visitors for copyright reasons until it's replaced
	# with original content. Credentials are shared with the site owner
	# out-of-band; the value below is a bcrypt hash of the password, not the
	# password itself. Regenerate with `caddy hash-password` if it changes.
	handle /ea-heidelberg* {
		basic_auth {
			ea $2b$10$fSkKRysO8YMswtC1ZXbqJ.Q3rbUE.uo6UL4iyOQZJz.QanpV8T/ci
		}
		reverse_proxy ea-heidelberg:3000
	}

	# public landing page — lists every installed module.
	handle {
		reverse_proxy landing:3000
	}

	log {
		output stdout
		format console
	}
}
