# For local development without Docker: copy to .env and run from
# modules/wg/ with `uv run uvicorn app.main:app --reload`.
# In the deployed stack these come from the root .env via compose.yaml
# instead - see /docs/module-integration.md.

APP_ENV=dev
PORT=8000
BASE_PATH=/wg
APP_BASE_URL=http://127.0.0.1:8000/wg
SECRET_KEY=dev-secret-key-change-me
DATABASE_PATH=./data/wg.db
BACKUP_DIR=./data/backups
NTFY_BASE_URL=https://ntfy.sh
TZ=Europe/Berlin
LOG_LEVEL=info
