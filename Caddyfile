{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# keep every page out of search engines (this site is not meant to be
	# publicly discoverable, e.g. when searching the operator's name).
	# Header applies even to reverse-proxied responses, so no module needs
	# to set this itself.
	header X-Robots-Tag "noindex, nofollow, noarchive, noimageindex"

	# modules with personal/sensitive data get Basic Auth in front of them.
	# note: `handle` (not `handle_path`) keeps the /wg prefix on the request
	# forwarded upstream — the module itself is prefix-aware (BASE_PATH=/wg),
	# so its own absolute links resolve correctly. Add one block per
	# protected module here.
	handle /wg* {
		basic_auth {
			{$WG_BASIC_AUTH_USER} {$WG_BASIC_AUTH_HASH}
		}
		reverse_proxy wg-manager:3000
	}

	# HöMa I lessons — public, static, no personal data. Answers and progress
	# live only in each visitor's browser (localStorage); nothing is collected.
	handle /hoema* {
		reverse_proxy hoema:3000
	}

	# public landing page — lists every installed module.
	handle {
		reverse_proxy landing:3000
	}

	log {
		output stdout
		format console
	}
}
